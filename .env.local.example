# PesanAman — template config Firebase (TIDAK berisi kredensial asli).
# Salin file ini menjadi `.env.local` lalu isi nilainya dari
# Firebase Console > Project settings > Your apps > Web app.
# `.env.local` sudah di-.gitignore dan TIDAK BOLEH di-commit.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opsional (App Check produksi, reCAPTCHA v3 site key):
VITE_FIREBASE_APPCHECK_SITE_KEY=
